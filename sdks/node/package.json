{
  "name": "sopops",
  "version": "0.5.3",
  "description": "Fetch your agent's instructions from sopops at call start, and send each finished session back.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elevenlabs": {
      "types": "./dist/elevenlabs.d.ts",
      "import": "./dist/elevenlabs.js"
    },
    "./livekit": {
      "types": "./dist/livekit.d.ts",
      "import": "./dist/livekit.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@elevenlabs/client": "1.28.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1",
  "homepage": "https://sopops.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sopops-dev/sopops.git",
    "directory": "sdks/node"
  },
  "bugs": {
    "url": "https://github.com/sopops-dev/sopops/issues"
  },
  "keywords": [
    "sopops",
    "sop",
    "voice agents",
    "livekit",
    "elevenlabs",
    "prompts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
