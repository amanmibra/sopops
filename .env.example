# sopops settings for `docker compose up`. Copy to .env and fill in what you use; leave the rest empty.
# Compose reads .env for the ${VAR} entries in docker-compose.yml and also passes the whole file to the app.
# Every setting is in README.md (Configuration). Never commit .env.

# The host port the app is published on (bound to 127.0.0.1).
SOPOPS_HOST_PORT=8484

# A Fernet key that encrypts platform keys, webhook secrets and GitHub tokens; needed to store them. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOPOPS_SECRET_KEY=

# Where people reach sopops (sign-in callbacks and invite links), e.g. https://sopops.example.com
SOPOPS_PUBLIC_URL=

# Sign-in: true or false forces it on or off. Unset, it's on once GitHub, Google or email is set up.
# true with nothing else set up: people sign in with an email and password.
SOPOPS_AUTH_REQUIRED=
# Comma-separated: only people with a verified email at these domains can sign in.
SOPOPS_ALLOWED_EMAIL_DOMAINS=
# true: anyone can sign up with a password and make a team of their own, which uses this server's model keys.
SOPOPS_OPEN_SIGNUP=

# Models that check sessions (LiteLLM model strings, e.g. anthropic/claude-haiku-4-5 and anthropic/claude-sonnet-5-5),
# and the provider's key. Unset, sessions are stored but not checked.
SOPOPS_MODEL_FAST=
SOPOPS_MODEL_REASONING=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sign in with GitHub (an OAuth app) and with Google (an OAuth client of type "Web application").
SOPOPS_GITHUB_OAUTH_CLIENT_ID=
SOPOPS_GITHUB_OAUTH_CLIENT_SECRET=
SOPOPS_GOOGLE_CLIENT_ID=
SOPOPS_GOOGLE_CLIENT_SECRET=

# Email: sign-in links, invites and reset links. Port 465 is TLS from the start; others use STARTTLS.
SOPOPS_SMTP_HOST=
SOPOPS_SMTP_PORT=587
SOPOPS_SMTP_USER=
SOPOPS_SMTP_PASSWORD=
SOPOPS_SMTP_FROM=
# 1: email sign-in without SMTP; links go to the app's log. Local use and demos only.
SOPOPS_EMAIL_DEV=

# Run the session pipeline on Hatchet (docker compose --profile hatchet; see docker-compose.yml).
HATCHET_CLIENT_TOKEN=
