# The walkthrough, one recipe per step. Run from this folder (`just <step>`) or the repo root (`just examples/walkthrough/<step>`).
# MODELS=fake (default) or real, e.g. `MODELS=real just all`. `just serve` in one terminal, the steps in another; or `just all` for everything.

models := env("MODELS", "fake")
py := "uv run --project ../.. --all-extras python"

# list the steps
default:
    @just --list --unsorted

# everything, from a fresh database; sopops stays up afterwards
all:
    {{py}} run_all.py --models {{models}}

# the same, then served behind a sign-in as test@example.com / password123
all-sign-in:
    {{py}} run_all.py --models {{models}} --sign-in

# 1. sopops on 127.0.0.1:8585 with the walkthrough's database
serve:
    {{py}} serve.py --models {{models}}

# 1. the same, from an empty database
fresh:
    {{py}} serve.py --models {{models}} --fresh

# 1. the same, with sign-in on and test@example.com / password123 to sign in as
sign-in:
    {{py}} serve.py --models {{models}} --sign-in

# 2. no coding agent: push the prepared proposal, resolve, apply, publish release 1
onboard:
    {{py}} onboard.py

# 2a. just push the proposal, to review it in the UI
onboard-push:
    {{py}} onboard.py push

# 2b. resolve the drift, apply and publish release 1
onboard-publish:
    {{py}} onboard.py publish

# 2 (instead). import the team's existing sop project (onboarding/sops), apply it, publish release 1
onboard-sop:
    {{py}} onboard.py sop

# 4. 200 backfill calls, 100 new ones, and the ground truth
generate *args:
    {{py}} generate.py {{args}}

# 5. send the backfill
backfill:
    {{py}} backfill.py

# 6. verdicts on the patterns, suggestions applied, release 2
review:
    {{py}} review.py

# 6a. just the verdicts (and wait for the suggestions)
review-verdicts:
    {{py}} review.py verdicts

# 6b. apply the suggestions as drafts
review-apply:
    {{py}} review.py apply

# 6c. publish release 2
review-publish:
    {{py}} review.py publish

# 7. the new calls through the LiveKit adapter, as if live
replay *args:
    {{py}} replay.py {{args}}

# 8. the checklist
verify:
    {{py}} verify.py --models {{models}}

# 9. two suggestions on one procedure: one merges, one conflicts and is rewritten
conflicts:
    {{py}} conflicts.py --models {{models}}

# 10. publish release 3 and play 60 calls in which its fixes held; a large-party fix left as a draft
followup:
    {{py}} followup.py

# remove out/ (the database, generated calls, tokens)
clean:
    rm -rf out

# the public demo: step 10 if it hasn't run, then record every page of the running walkthrough (WALKTHROUGH_WORKSPACE=harbor-lane), then build the
# demo UI into web/dist-demo, a static site with no sopops behind it
demo:
    [ -f out/followup.jsonl ] || {{py}} followup.py
    uv run --project ../.. --with playwright python record_demo.py
    cd ../../web && pnpm build:demo

# look at the demo build on http://127.0.0.1:4180
demo-preview:
    cd ../../web && pnpm exec vite preview --outDir dist-demo --port 4180
