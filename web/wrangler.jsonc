// Optional: the UI as a Cloudflare Worker (Workers Static Assets), for a deployment that serves it from Cloudflare
// rather than from the sopops server. Self-hosting doesn't use this file: `pnpm build` and the server serving web/dist
// are unchanged. sopops.dev deploys it with Workers Builds (Cloudflare's GitHub connection), root directory `web`.
//
// `pnpm build:cloudflare` builds for a sub-path (default /app/, the API at /api; set SOPOPS_WEB_BASE and
// SOPOPS_WEB_API_BASE to change them) into dist-cloudflare/. The Worker expects a router in front that takes the base
// off the path before forwarding (sopops.dev/app/w/demo arrives as /w/demo), so every page that isn't a file gets
// index.html and the client-side router takes it. No account, zone or hostname is named here: the Worker is reached
// only through that router's service binding, attached in the Cloudflare dashboard.
{
  "name": "sopops-app",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "pnpm build:cloudflare" },
  "assets": {
    "directory": "./dist-cloudflare",
    "not_found_handling": "single-page-application",
    // Paths are served as asked: no /index.html -> / redirects, which would name a path without the router's base.
    "html_handling": "none"
  }
}
