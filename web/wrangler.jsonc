// Optional: the UI as a Cloudflare Worker (Workers Static Assets), for a deployment that serves it from Cloudflare
// rather than from the sopops server. Self-hosting doesn't use this file: `pnpm build` and the server serving web/dist
// are unchanged. sopops.dev deploys it with Workers Builds (Cloudflare's GitHub connection), root directory `web`.
//
// `pnpm build:cloudflare` builds for a sub-path (default /app/, the API at /api; set SOPOPS_WEB_BASE and
// SOPOPS_WEB_API_BASE to change them) under that path in dist-cloudflare/ (cloudflare/build.mjs), so the Worker answers
// sopops.dev/app/... with the path as it is: a Workers route sends it the requests, nothing takes the base off. Every
// page that isn't a file gets index.html and the client-side router takes it. No account, zone or hostname is named
// here: the route is managed with the rest of sopops.dev's Cloudflare configuration.
{
  "name": "sopops-app",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "pnpm build:cloudflare" },
  "assets": {
    "directory": "./dist-cloudflare",
    "not_found_handling": "single-page-application",
    // /app -> /app/, and /app/index.html -> /app/.
    "html_handling": "auto-trailing-slash"
  }
}
